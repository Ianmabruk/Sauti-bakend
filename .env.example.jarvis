# =============================================================================
# JARVIS voice agent — configuration
# =============================================================================
# Copy to `.env` and edit. Every value below is optional: the agent boots in a
# degraded mode without any of them, and `python -m jarvis --check` will tell
# you exactly what is and is not available.
#
# NOTHING HERE IS A PAID SERVICE. Groq, Edge TTS and Parallel Search all have
# free tiers, and Parallel's hosted MCP endpoint needs no key at all.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. GROQ — serves BOTH the chat model and speech-to-text. One key, two models.
# -----------------------------------------------------------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Chat model. Llama 3.3 70B is fast and strong enough for a voice turn.
GROQ_MODEL=llama-3.3-70b-versatile

# Speech-to-text model.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Turn shape. Lower max_tokens makes JARVIS more concise, which matters because
# every extra sentence is extra time before the answer finishes speaking.
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=512
LLM_TIMEOUT=30
# Retries on a 429 before falling back to the local model.
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE=0.6
LLM_BACKOFF_MAX=12

# Reply cache: 100 most recent answers, replayed instantly. Set to 0 to disable.
LLM_CACHE_MAX=100
LLM_CACHE_TTL=0

# -----------------------------------------------------------------------------
# 2. LOCAL FALLBACK — used automatically when Groq rate-limits us
# -----------------------------------------------------------------------------
# Optional. Install from https://ollama.com then: `ollama pull llama3.2`
# When it is not running, JARVIS apologises instead of failing silently.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=25
# Short, so a missing Ollama is detected in milliseconds rather than stalling.
OLLAMA_PROBE_TIMEOUT=1.5

# -----------------------------------------------------------------------------
# 3. WEB SEARCH — keyless
# -----------------------------------------------------------------------------
# Parallel's hosted MCP server. No account, no API key, no OAuth.
# It is occasionally flaky and returns intermittent 502s, so JARVIS retries and
# then falls back to DuckDuckGo (also keyless) before giving up.
SEARCH_ENABLED=true
SEARCH_URL=https://search.parallel.ai/mcp
SEARCH_TIMEOUT=15
SEARCH_MAX_RETRIES=2
SEARCH_MAX_RESULTS=6
# Search results are cached for 10 minutes, so "and the price?" is instant.
SEARCH_CACHE_TTL=600
SEARCH_CACHE_MAX=256

# -----------------------------------------------------------------------------
# 4. VOICE ACTIVITY DETECTION
# -----------------------------------------------------------------------------
# The microphone stops the moment you stop talking. These are the knobs for
# how eager it should be to cut you off.
#
#   VAD_AGGRESSIVENESS  0 lenient (keeps quiet speakers going) … 3 strict
#   VAD_SILENCE_MS      how long you must pause before it considers you done
#   VAD_SPEECH_MS       continuous voice needed to open an utterance
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=700
VAD_SPEECH_MS=250
VAD_MIN_UTTERANCE_MS=400
# Hard cap, so a stuck-open microphone cannot record forever.
VAD_MAX_UTTERANCE_S=25
# Only used by the fallback energy detector when webrtcvad is not installed.
VAD_ENERGY_THRESHOLD=500
VAD_FRAME_MS=20

SAMPLE_RATE=16000
# ALSA device name, e.g. "default", "hw:1,0". Leave blank for the system default.
MIC_DEVICE=
# Raise this if JARVIS hears you too quietly.
MIC_GAIN=1.0

# -----------------------------------------------------------------------------
# 5. TEXT TO SPEECH — Microsoft Edge, free and keyless
# -----------------------------------------------------------------------------
TTS_ENABLED=true
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=+8%
TTS_PITCH=+0Hz
TTS_VOLUME=+0%
TTS_TIMEOUT=20
# ffplay, mpg123, mpv or afplay. Set blank to print answers instead of speaking.
TTS_PLAYER=ffplay

# -----------------------------------------------------------------------------
# 6. MEMORY
# -----------------------------------------------------------------------------
# The last N turns are kept verbatim; everything older is compacted into a
# running summary that survives a restart.
MEMORY_WINDOW=10
MEMORY_STATE_PATH=jarvis_state.json
MEMORY_SUMMARY_MAX_CHARS=2000
MEMORY_SUMMARISE=true

# -----------------------------------------------------------------------------
# 7. BEHAVIOUR
# -----------------------------------------------------------------------------
AGENT_SPEAK=true
AGENT_USER_NAME=sir
# Characters buffered before the first sentence is spoken. Raise it to be more
# patient, lower it to start talking sooner.
AGENT_FIRST_SENTENCE_CHARS=60
AGENT_MAX_TOOL_ROUNDS=3

# -----------------------------------------------------------------------------
# 8. LOGS
# -----------------------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Set LOG_JSON=true for machine-readable
# newline-delimited JSON, optionally written to LOG_FILE.
LOG_LEVEL=INFO
LOG_FILE=
LOG_JSON=false
