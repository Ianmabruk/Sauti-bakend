# SautiPay / SAUTI Environment Configuration
# Copy this file to .env and fill in the values. Never commit .env.

# Application
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production-32-chars-min
DEBUG=false

# Database
# SQLite for development. Swap for PostgreSQL in production, e.g.
# postgresql://sautipay:sautipay@localhost:5432/sautipay
DATABASE_URL=sqlite:///sautipay.db

# ---------------------------------------------------------------------------
# SAUTI agent
# ---------------------------------------------------------------------------

# Groq (primary AI engine). Serves both chat and Whisper speech-to-text from a
# single key. Server-side only: it is never sent to the browser, never bundled
# into the frontend, and never written to a response.
# Get a free key at https://console.groq.com/keys
# Leave empty to fall back to the secondary engine below.
GROQ_API_KEY=
# Must be a model your account can actually reach. Verify with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
# Good defaults: qwen/qwen3.8-27b (fast, multilingual) or openai/gpt-oss-120b.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_TEMPERATURE=0.3
GROQ_MAX_TOKENS=1200
GROQ_TIMEOUT=45
GROQ_MAX_TOOL_ROUNDS=3
GROQ_MAX_AUDIO_BYTES=8388608

# Google Gemini (secondary AI engine, used when GROQ_API_KEY is empty or Groq
# fails). Server-side only. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_TOKENS=1200
GEMINI_TIMEOUT=45
GEMINI_MAX_TOOL_ROUNDS=3

# Language model. Leave LLM_API_KEY empty to run SAUTI without a model: it will
# then answer with a deterministic, source-grounded summary and say so.
# Any OpenAI-compatible endpoint works.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=900
LLM_TIMEOUT=45

# Web search provider: auto | brave | tavily | serpapi | open-meteo | duckduckgo | stub
# auto chooses a key-backed provider when configured; weather/forecast queries without
# a key automatically use Open-Meteo. "duckduckgo" needs no key but is frequently
# blocked by anti-bot challenges. "stub" is offline/test-only.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
SEARCH_TIMEOUT=12
SEARCH_RETRIES=2
SEARCH_MAX_RESULTS=8
SEARCH_MAX_PAGES_TO_READ=4

# Page reader
READER_TIMEOUT=12
READER_MAX_BYTES=1500000

# Agent behaviour
AGENT_MAX_TOOL_STEPS=4
AGENT_HISTORY_LIMIT=12
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=5

# Safety. Keep false unless you understand what you are enabling.
# Future tools (filesystem, terminal, computer control) require this.
ENABLE_DANGEROUS_TOOLS=false

# ---------------------------------------------------------------------------
# SautiPay frontend content system
# ---------------------------------------------------------------------------

# Model Configuration
MODEL_PROVIDER=mock
LOCAL_MODEL_PATH=/models/sauti-model
LOCAL_MODEL_MAX_TOKENS=1024
LOCAL_MODEL_TEMPERATURE=0.7

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
# 4 workers × 10 threads = roughly 40 concurrent requests on the backend.
SAUTI_CHAT_RATE_LIMIT=40 per minute
WEB_CONCURRENCY=4

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin content management
ADMIN_TOKEN=change-me-to-a-long-random-string
MEDIA_ROOT=./instance/media
MAX_CONTENT_LENGTH=52428800

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Paystack vendor subscriptions (TEST MODE)
# ---------------------------------------------------------------------------
# Server-side only. The secret key authenticates this backend to Paystack and
# signs webhook verification. It must never reach the browser, the frontend
# bundle, a log line or an error message. The only frontend-facing key is
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY, which belongs in the frontend's environment
# and is NOT read by this service.
#
# TEST MODE ONLY until you deliberately switch. Get both keys from
# https://dashboard.paystack.com/#/settings/developers with Test Mode toggled on.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# The KSh 100 monthly plan's real Test Mode code (PLN_...). Leave empty until
# the plan actually exists in the Paystack Test dashboard — checkout is refused
# with a clear message until then, rather than failing deep inside Paystack with
# an unknown-plan error that points at the wrong layer.
#   curl https://api.paystack.co/plan \
#     -H "Authorization: Bearer $PAYSTACK_SECRET_KEY" \
#     -d '{"name":"Sauti Vendor Subscription","amount":10000,"currency":"KES","interval":"monthly"}'
PAYSTACK_PLAN_CODE=

# The frontend's public origin, used to build the post-checkout return URL.
# Paystack sends the customer to <PUBLIC_SITE_URL>/payment/callback?reference=...
PUBLIC_SITE_URL=http://localhost:3000

# Leave false/absent in every non-live deployment. While it is false a live
# secret key (sk_live_) is refused at request time, so pasting a live key into a
# test environment cannot start charging real money.
PAYSTACK_ALLOW_LIVE=false

# Application-level abuse controls. Card-level risk is Paystack's job; these
# bound how often one caller can spin up checkout sessions.
PAYSTACK_INIT_RATE_LIMIT=5 per minute
PAYSTACK_VERIFY_RATE_LIMIT=20 per minute
PAYSTACK_TOKEN_RATE_LIMIT=10 per minute

# Where rate-limit counters are kept.
#
# memory:// stores them in the Python process. That is fine for `flask run` and
# wrong for anything with more than one worker: every worker keeps a private
# tally, so the effective limit is multiplied by the worker count and a restart
# resets all counters. Production should use a shared store, e.g.
#   RATE_LIMIT_STORAGE=redis://:<password>@<host>:6379/0
# The app logs a warning at boot when FLASK_ENV=production and this is memory://.
RATE_LIMIT_STORAGE=memory://

# A checkout left un-paid inside this window is reused rather than replaced, so a
# double-tap on Subscribe does not orphan a reference.
PAYSTACK_REUSE_WINDOW_SECONDS=900

# Lifetime of an issued vendor token.
PAYSTACK_TOKEN_TTL_SECONDS=604800

# Only change to point tests at a sandbox. Leave as the default otherwise.
PAYSTACK_API_URL=https://api.paystack.co
PAYSTACK_TIMEOUT=15
