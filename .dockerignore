__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# Local data
instance/
*.db
*.sqlite
*.sqlite3
*.log

# Frontend (not part of this image)
node_modules/
.next/
sautipay/

# Docs and CI
docs/
tests/
render.yaml
docker-compose.yml
Dockerfile*
README.md
